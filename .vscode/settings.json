{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never"
  },
  "editor.rulers": [100],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [{ "directory": "apps/web", "changeProcessCWD": true }],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue"],
  "prettier.requireConfig": true,
  "typescript.tsdk": "apps/web/node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "emmet.includeLanguages": {
    "vue": "html"
  },
  "tailwindCSS.experimental.configFile": {
    "apps/web/src/assets/main.css": "apps/web/src/**"
  },
  "search.exclude": {
    "**/dist": true,
    "**/coverage": true,
    "**/node_modules": true,
    "**/vendor": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true
  },
  "[javascript][javascriptreact][typescript][typescriptreact][vue][json][jsonc][css][scss][html][markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
